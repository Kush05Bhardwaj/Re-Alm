# Web app
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000

# MongoDB: use Atlas for shared environments. The compose file provides local MongoDB.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=realm

# Ollama (local, optional for startup; required for the AI readiness check)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
