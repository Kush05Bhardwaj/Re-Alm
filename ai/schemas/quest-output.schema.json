{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIQuestOutput",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "description", "objectives", "rewards", "level"],
  "properties": {
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "objectives": { "type": "array", "minItems": 1, "maxItems": 10, "items": { "$ref": "#/$defs/objective" } },
    "rewards": { "type": "array", "maxItems": 5, "items": { "$ref": "#/$defs/reward" } },
    "level": { "type": "integer", "minimum": 1, "maximum": 100 }
  },
  "$defs": {
    "objective": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "description", "optional", "verification"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1, "maxLength": 500 },
        "optional": { "type": "boolean" },
        "verification": { "enum": ["self_reported", "ai_review", "server_validated", "human_review"] }
      }
    },
    "reward": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "quantity", "rarity"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "quantity": { "type": "integer", "minimum": 1 },
        "rarity": { "enum": ["common", "uncommon", "rare", "epic", "legendary"] },
        "description": { "type": ["string", "null"], "maxLength": 500 }
      }
    }
  }
}
