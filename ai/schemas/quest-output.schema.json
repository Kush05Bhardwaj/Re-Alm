{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIQuestOutput",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "description", "category", "difficulty", "estimated_minutes", "objectives", "verification", "xp_reward", "aether_reward"],
  "properties": {
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "category": { "enum": ["exploration", "observation", "discovery", "mystery", "photography", "challenge", "chaos", "story"] },
    "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
    "estimated_minutes": { "type": "integer", "minimum": 5, "maximum": 240 },
    "objectives": { "type": "array", "minItems": 2, "maxItems": 5, "items": { "$ref": "#/$defs/objective" } },
    "verification": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "enum": ["self_reported", "ai_review", "server_validated", "human_review"] } },
    "xp_reward": { "type": "integer", "minimum": 0, "maximum": 2000 },
    "aether_reward": { "type": "integer", "minimum": 0, "maximum": 100 }
  },
  "$defs": {
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "optional", "verification"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1, "maxLength": 500 },
        "optional": { "type": "boolean" },
        "verification": { "enum": ["self_reported", "ai_review", "server_validated", "human_review"] }
      }
    }
  }
}
